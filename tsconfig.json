{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"], // Add this line
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": false // Ensure this is false so files actually get created
  },
  "include": ["src/**/*"] // Tell TS where your code lives
}
